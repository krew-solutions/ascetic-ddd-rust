    {
      "type": "object",
      "properties": {
        "header": {
          "$ref": "#/$defs/header"
        }
      },
      "required": [
        "header"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "read": {
          "$ref": "#/$defs/read"
        }
      },
      "required": [
        "read"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "released": {
          "$ref": "#/$defs/released"
        }
      },
      "required": [
        "released"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "dispatch": {
          "$ref": "#/$defs/dispatch"
        }
      },
      "required": [
        "dispatch"
      ],
      "additionalProperties": false
    },
    {
