          "$ref": "#/$defs/answer"
        }
      },
      "required": [
        "answer"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "end": {
          "$ref": "#/$defs/ended"
        }
      },
      "required": [
        "end"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "fault": {
          "$ref": "#/$defs/fault"
        }
      },
      "required": [
        "fault"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "sample": {
          "$ref": "#/$defs/sample"
        }
      },
