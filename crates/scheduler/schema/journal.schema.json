    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "b64": {
      "type": "string",
      "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "name": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "on": {
      "enum": [
        "sent",
        "expected",
        "settled"
      ]
    },
    "action": {
      "enum": [
        "rest",
        "bus",
        "observe",
        "poll",
        "host"
      ]
    },
    "judged": {
      "enum": [
        "expected",
        "unexpected",
        "not_taken",
        "unknown"
      ]
    },
    "ignored": {
