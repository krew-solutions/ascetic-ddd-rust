        },
        {
          "const": "poisoned"
        },
        {
          "type": "object",
          "properties": {
            "saturated": {
              "type": "object",
              "properties": {
                "alive": {
                  "$ref": "#/$defs/u64"
                }
              },
              "required": [
                "alive"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "saturated"
          ],
          "additionalProperties": false
        },
        {
          "const": "clock"
        },
        {
          "type": "object",
          "properties": {
